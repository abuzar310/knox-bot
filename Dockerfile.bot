FROM node:22-bookworm-slim AS base
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends wget ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/bot ./apps/bot
RUN pnpm install --frozen-lockfile || pnpm install

FROM deps AS build
RUN pnpm --filter @knox/shared build \
 && pnpm --filter @knox/config build \
 && pnpm --filter @knox/db build \
 && pnpm --filter @knox/bot build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
WORKDIR /app
ENV PORT=3080
EXPOSE 3080
CMD ["pnpm", "--filter", "@knox/bot", "start"]
